    // Rules 1–4: validation first\n    if (now === null || now < 0 || now > 1440) return bad('INVALID_INPUT', 'Current time (now) must be a whole number between 0 and 1440.');\n    if (start === null || duration === null) return bad('INVALID_INPUT', 'Start time and duration must be whole numbers.');\n    if (duration <= 0 || duration > 120) return bad('INVALID_DURATION', 'Duration must be between 1 and 120 minutes.');\n    if (start <= now) return bad('PAST_TIME', `Start time must be in the future (now is ${now}).`);\n    const end = start + duration;\n    if (start < 0 || end > 1440) return bad('INVALID_TIME', 'The booking must start and end within the same day (0–1440 minutes).');\n\n    // Rule 5: blocked room\n    if (blocked) return { available: false, status: 'Unavailable', reasonCode: 'ROOM_BLOCKED', message: 'Room A-101 is blocked and cannot be booked.' };\n\n    // Rule 6: overlap (touching endpoints allowed)\n    const c = this.bookings.find(b => Math.max(start, b.start) < Math.min(end, b.end));\n    if (c) return { available: false, status: 'Unavailable', reasonCode: 'OVERLAP', message: `Unavailable: ${start}–${end} overlaps the existing booking ${c.start}–${c.end}.` };\n\n    // Rule 7: available\n    return { available: true, status: 'Available', reasonCode: 'AVAILABLE', message: `Available: Room A-101 is free from ${start} to ${end} (${duration} min).` };\n  },\n\n  check() {\n    const r = this.evaluate(inp_now.text, inp_start.text, inp_duration.text, chk_blocked.isChecked);\n    return storeValue('result', r);\n  }\n}","variables":[{"name":"bookings","value":"[{\n  start: 600,\n  end: 660\n}]"}],"userPermissions":[]},"publishedCollection":{"name":"Checker","pageId":"Page1","pluginId":"js-plugin","pluginType":"JS","actions":[],"archivedActions":[],"body":"export default {\n  // Fictional fixture from contract.md (read-only)\n  bookings: [{ start: 600, end: 660 }],\n\n  toWhole(v) {\n    const s = String(v ?? '').trim();\n    return /^-?\\d+$/.test(s)